# Duka POS — local configuration template
# Copy this file to .env for local development.
# Never commit .env. Never put live secrets in GitHub.

# Runtime
DUKA_POS_ENV=development

# Local SQLite path relative to the project root.
# The database file is not created in Milestone 0.
# Do not point this at a cloud database. SQLite is the source of truth.
DUKA_POS_DATABASE_PATH=data/duka_pos.sqlite

# Local HTTP bind (the API itself is not implemented in Milestone 0)
DUKA_POS_HOST=127.0.0.1
DUKA_POS_PORT=8000
